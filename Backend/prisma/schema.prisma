// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum Role {
  TEAM_MEMBER
  TEAM_LEAD
}

enum Category {
  CLIENT
  TECH_DEBT
  RND
}

enum BacklogStatus {
  BACKLOG
  PLANNED
  IN_PROGRESS
  COMPLETED
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  password       String
  name           String
  role           Role             @default(TEAM_MEMBER)
  assignments    TaskAssignment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model BacklogItem {
  id             String           @id @default(uuid())
  title          String
  description    String?
  category       Category
  estimatedHours Float
  status         BacklogStatus    @default(BACKLOG)
  assignments    TaskAssignment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model WeeklyPlan {
  id                  String             @id @default(uuid())
  startDate           DateTime
  endDate             DateTime
  isFrozen            Boolean            @default(false)
  clientPercentage    Float              @default(0)
  techDebtPercentage  Float              @default(0)
  rndPercentage       Float              @default(0)
  totalAvailableHours Float              @default(30)
  allocations         PlanAllocation[]
  assignments         TaskAssignment[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model PlanAllocation {
  id           String     @id @default(uuid())
  weeklyPlanId String
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id])
  category     Category
  allocatedHours Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([weeklyPlanId, category])
}

model TaskAssignment {
  id             String        @id @default(uuid())
  weeklyPlanId   String
  weeklyPlan     WeeklyPlan    @relation(fields: [weeklyPlanId], references: [id])
  backlogItemId  String
  backlogItem    BacklogItem   @relation(fields: [backlogItemId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  assignedHours  Float
  progressPercentage Int       @default(0)
  status         BacklogStatus @default(PLANNED)
  logs           ProgressLog[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([weeklyPlanId, backlogItemId, userId])
}

model ProgressLog {
  id               String         @id @default(uuid())
  taskAssignmentId String
  taskAssignment   TaskAssignment @relation(fields: [taskAssignmentId], references: [id])
  progressPercentage Int
  comment          String?
  createdAt        DateTime       @default(now())
}
